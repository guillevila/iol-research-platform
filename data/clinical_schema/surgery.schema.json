{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iol-research/surgery.schema.json",
  "title": "Registro quirúrgico (anonimizado, sin PII)",
  "type": "object",
  "required": ["patient_case_id", "eye", "iol_manufacturer", "iol_model", "iol_power_d"],
  "additionalProperties": false,
  "properties": {
    "patient_case_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$" },
    "eye": { "enum": ["OD", "OS"] },
    "iol_manufacturer": { "type": "string" },
    "iol_model": { "type": "string" },
    "iol_power_d": { "type": "number", "minimum": -15, "maximum": 60 },
    "toric_cylinder_d": { "type": ["number", "null"], "minimum": 0, "maximum": 12 },
    "intended_axis_deg": { "type": ["number", "null"], "minimum": 0, "maximum": 180 },
    "incision_axis_deg": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
    "incision_width_mm": { "type": ["number", "null"], "minimum": 1, "maximum": 6 },
    "sia_assumed_d": { "type": ["number", "null"], "minimum": 0, "maximum": 3 },
    "surgeon_id": { "type": ["string", "null"], "description": "ANONIMIZADO (código de centro)" },
    "surgery_period": { "type": ["string", "null"], "description": "Generalizado (p.ej. 2026-Q3); no fecha exacta si el centro lo exige", "pattern": "^[0-9]{4}(-Q[1-4]|-[0-9]{2})?$" },
    "complications": { "type": ["string", "null"] }
  }
}
